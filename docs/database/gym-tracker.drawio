        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;erDiagram\n    ATLETA ||--o{ FICHA_DE_TREINO : possui\n    GRUPO_MUSCULAR ||--o{ EXERCICIO : categoriza\n    FICHA_DE_TREINO ||--o{ ITEM_FICHA_DE_TREINO : contem\n    EXERCICIO ||--o{ ITEM_FICHA_DE_TREINO : usado_em\n\n    ATLETA {\n        int id PK\n        string username\n        string first_name\n        string last_name\n        string email\n        string password\n        date birth_date\n        decimal height\n        decimal weight\n        string goal\n        boolean is_active\n        boolean is_staff\n        datetime date_joined\n    }\n\n    GRUPO_MUSCULAR {\n        int id PK\n        string name\n        string slug\n        text description\n        datetime created_at\n        datetime updated_at\n    }\n\n    EXERCICIO {\n        int id PK\n        int muscle_group_id FK\n        string name\n        string slug\n        text description\n        string equipment\n        string difficulty\n        datetime created_at\n        datetime updated_at\n    }\n\n    FICHA_DE_TREINO {\n        int id PK\n        int athlete_id FK\n        string name\n        string objective\n        text notes\n        datetime created_at\n        datetime updated_at\n    }\n\n    ITEM_FICHA_DE_TREINO {\n        int id PK\n        int workout_plan_id FK\n        int exercise_id FK\n        int sets\n        string reps\n        decimal load\n        int rest_seconds\n        int order\n    }&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="CKxcQloPDSWFmhVX58xA-187">
